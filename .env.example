# Copy this to .env.local and fill in your Supabase credentials.
# Get these from Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Your site's public address (no trailing slash). Used for search-engine canonical links,
# the sitemap and social-preview images. Set it in your host's environment settings too.
VITE_SITE_URL=https://roadfix.example.com
